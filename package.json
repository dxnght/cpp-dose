{
  "name": "cpp-dose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CPP-DOSE — offline IV drip-rate & dosing support for Prolonged Casualty Care (CPP). Android / iOS / PWA, fully offline, fail-closed clinical content.",
  "scripts": {
    "postinstall": "patch-package",
    "predev": "npm run compile:field",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "apk:debug": "npm run build && cap sync android && npm run android:patch && cd android && ./gradlew assembleDebug",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate": "node scripts/validate.mjs",
    "verify": "node scripts/verify.mjs",
    "compile:field": "node scripts/compile-field.mjs",
    "gate:release": "node scripts/gate-release.mjs",
    "verify:record": "node scripts/verify-record.mjs",
    "prebuild": "npm run validate && npm run compile:field",
    "pretest": "npm run compile:field",
    "test": "vitest run",
    "cap:sync": "cap sync android && npm run android:patch",
    "android:patch": "node scripts/patch-android-manifest.mjs",
    "ios:sync": "cap sync ios",
    "ios:open": "npm run build && cap sync ios && cap open ios",
    "build:play": "VITE_VARIANT=play npm run build",
    "apk:play": "VITE_VARIANT=play npm run build && VITE_VARIANT=play npx cap sync android && VITE_VARIANT=play node scripts/patch-android-manifest.mjs && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.9.1",
    "jsdom": "^25.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.0.5"
  }
}
